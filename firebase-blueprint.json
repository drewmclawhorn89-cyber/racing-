{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Preserved private authenticated driver profile synced to Google Sign-In.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 60 },
        "email": { "type": "string", "format": "email", "maxLength": 120 },
        "photoURL": { "type": "string", "maxLength": 400 },
        "onlineName": { "type": "string", "minLength": 1, "maxLength": 16 },
        "coins": { "type": "number" },
        "xp": { "type": "number" },
        "wins": { "type": "number" },
        "selectedCar": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 20 },
        "selectedTrack": { "type": "string", "enum": ["city", "desert", "mountain", "coastal"], "maxLength": 16 },
        "unlockedCars": { "type": "array" },
        "weather": { "type": "string", "enum": ["sunset", "day", "night", "rain"], "maxLength": 12 },
        "volume": { "type": "number" },
        "muted": { "type": "boolean" },
        "touch": { "type": "string", "enum": ["auto", "on", "off"], "maxLength": 8 },
        "cameraMode": { "type": "number" },
        "laps": { "type": "number" },
        "difficulty": { "type": "string", "enum": ["easy", "medium", "hard"], "maxLength": 12 },
        "custom": { "type": "object" },
        "leaderboards": { "type": "object" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "ownerId", "displayName", "email", "photoURL", "onlineName", "coins", "xp", "wins",
        "selectedCar", "selectedTrack", "unlockedCars", "weather", "volume", "muted", "touch",
        "cameraMode", "laps", "difficulty", "custom", "leaderboards", "createdAt", "updatedAt"
      ]
    },
    "UserGhost": {
      "title": "UserGhost",
      "description": "Preserved Time Trial ghost replay path per circuit.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "trackId": { "type": "string", "enum": ["city", "desert", "mountain", "coastal"], "maxLength": 16 },
        "lapTime": { "type": "number" },
        "coords": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "trackId", "lapTime", "coords", "createdAt", "updatedAt"]
    },
    "TrackRecord": {
      "title": "TrackRecord",
      "description": "Preserved track record entry.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "driverName": { "type": "string", "minLength": 1, "maxLength": 24 },
        "trackId": { "type": "string", "enum": ["city", "desert", "mountain", "coastal"], "maxLength": 16 },
        "carName": { "type": "string", "minLength": 1, "maxLength": 40 },
        "mode": { "type": "string", "enum": ["Race", "Time Trial", "Online"], "maxLength": 16 },
        "time": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "driverName", "trackId", "carName", "mode", "time", "createdAt", "updatedAt"]
    },
    "Player": {
      "title": "Player",
      "description": "Battle Royale player progression, Battle Pass, Daily Quests, and character loadout synced to Google Sign-In.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "username": { "type": "string", "minLength": 1, "maxLength": 24 },
        "avatar": { "type": "string", "maxLength": 400 },
        "level": { "type": "number" },
        "xp": { "type": "number" },
        "wins": { "type": "number" },
        "kills": { "type": "number" },
        "coins": { "type": "number" },
        "matchesPlayed": { "type": "number" },
        "battlePassTier": { "type": "number" },
        "battlePassPremium": { "type": "boolean" },
        "loadout": { "type": "object" },
        "quests": { "type": "object" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "ownerId", "username", "avatar", "level", "xp", "wins", "kills", "coins",
        "matchesPlayed", "battlePassTier", "battlePassPremium", "loadout", "quests",
        "createdAt", "updatedAt"
      ]
    },
    "Match": {
      "title": "Match",
      "description": "Completed Battle Royale match record.",
      "type": "object",
      "properties": {
        "match_id": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 64 },
        "mode": { "type": "string", "enum": ["solo", "duo", "squad", "zerobuild", "creative"], "maxLength": 16 },
        "players": { "type": "array" },
        "winner": { "type": "string", "minLength": 1, "maxLength": 48 },
        "started_at": { "type": "string", "maxLength": 48 },
        "ended_at": { "type": "string", "maxLength": 48 },
        "createdBy": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["match_id", "mode", "players", "winner", "started_at", "ended_at", "createdBy", "createdAt", "updatedAt"]
    },
    "InventoryItem": {
      "title": "InventoryItem",
      "description": "Owned cosmetic item in player locker.",
      "type": "object",
      "properties": {
        "player_id": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "item_id": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 48 },
        "item_type": { "type": "string", "enum": ["skin", "hair", "backpack", "pickaxe", "glider", "emote"], "maxLength": 16 },
        "equipped": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["player_id", "item_id", "item_type", "equipped", "createdAt", "updatedAt"]
    },
    "ShopItem": {
      "title": "ShopItem",
      "description": "Daily item shop catalog entry.",
      "type": "object",
      "properties": {
        "item_id": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 48 },
        "name": { "type": "string", "minLength": 1, "maxLength": 48 },
        "price": { "type": "number" },
        "rarity": { "type": "string", "enum": ["common", "uncommon", "rare", "epic", "legendary"], "maxLength": 16 },
        "type": { "type": "string", "enum": ["skin", "hair", "backpack", "pickaxe", "glider", "emote"], "maxLength": 16 }
      },
      "required": ["item_id", "name", "price", "rarity", "type"]
    },
    "FriendLink": {
      "title": "FriendLink",
      "description": "Friend relationship between players.",
      "type": "object",
      "properties": {
        "player_id": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "friend_id": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "friend_name": { "type": "string", "minLength": 1, "maxLength": 24 },
        "status": { "type": "string", "enum": ["pending", "accepted", "blocked"], "maxLength": 16 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["player_id", "friend_id", "friend_name", "status", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Preserved owner-isolated racing profile."
    },
    "/users/{userId}/ghosts/{trackId}": {
      "schema": { "$ref": "#/entities/UserGhost" },
      "description": "Preserved Time Trial ghost replay path."
    },
    "/trackRecords/{recordId}": {
      "schema": { "$ref": "#/entities/TrackRecord" },
      "description": "Preserved track record leaderboard."
    },
    "/players/{playerId}": {
      "schema": { "$ref": "#/entities/Player" },
      "description": "Battle Royale player progression, loadout, battle pass, and stats."
    },
    "/matches/{matchId}": {
      "schema": { "$ref": "#/entities/Match" },
      "description": "Battle Royale match history records."
    },
    "/inventory/{entryId}": {
      "schema": { "$ref": "#/entities/InventoryItem" },
      "description": "Player owned cosmetic items."
    },
    "/shop_items/{itemId}": {
      "schema": { "$ref": "#/entities/ShopItem" },
      "description": "Daily shop items."
    },
    "/friends/{friendshipId}": {
      "schema": { "$ref": "#/entities/FriendLink" },
      "description": "Player friend relationships."
    }
  }
}
