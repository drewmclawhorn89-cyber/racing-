rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedSignedIn() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isVerifiedSignedIn() && request.auth.uid == userId;
    }

    // ===== Preserved Racing Helpers =====
    function isValidTrackId(t) {
      return t is string && t.size() >= 1 && t.size() <= 16 && t in ['city', 'desert', 'mountain', 'coastal'];
    }

    function isValidWeather(w) {
      return w is string && w.size() >= 1 && w.size() <= 12 && w in ['sunset', 'day', 'night', 'rain'];
    }

    function isValidTouch(t) {
      return t is string && t.size() >= 1 && t.size() <= 8 && t in ['auto', 'on', 'off'];
    }

    function isValidDifficulty(d) {
      return d is string && d.size() >= 1 && d.size() <= 12 && d in ['easy', 'medium', 'hard'];
    }

    function isValidLapList(list) {
      return list is list
        && list.size() <= 10
        && (list.size() == 0 || (
          list[0] is map
          && list[0].keys().hasAll(['time', 'car', 'mode', 'date'])
          && list[0].keys().hasOnly(['time', 'car', 'mode', 'date'])
          && list[0].time is number && list[0].time > 1 && list[0].time <= 3600
          && list[0].car is string && list[0].car.size() >= 1 && list[0].car.size() <= 40
          && list[0].mode is string && list[0].mode.size() >= 1 && list[0].mode.size() <= 16
          && list[0].date is string && list[0].date.size() >= 1 && list[0].date.size() <= 32
        ));
    }

    function isValidLeaderboards(lb) {
      return lb is map
        && lb.keys().hasAll(['city', 'desert', 'mountain', 'coastal'])
        && lb.keys().hasOnly(['city', 'desert', 'mountain', 'coastal'])
        && isValidLapList(lb.city)
        && isValidLapList(lb.desert)
        && isValidLapList(lb.mountain)
        && isValidLapList(lb.coastal);
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll([
          'ownerId', 'displayName', 'email', 'photoURL', 'onlineName',
          'coins', 'xp', 'wins', 'selectedCar', 'selectedTrack',
          'unlockedCars', 'weather', 'volume', 'muted', 'touch',
          'cameraMode', 'laps', 'difficulty', 'custom', 'leaderboards',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'displayName', 'email', 'photoURL', 'onlineName',
          'coins', 'xp', 'wins', 'selectedCar', 'selectedTrack',
          'unlockedCars', 'weather', 'volume', 'muted', 'touch',
          'cameraMode', 'laps', 'difficulty', 'custom', 'leaderboards',
          'createdAt', 'updatedAt'
        ])
        && data.ownerId is string
        && isValidId(data.ownerId)
        && data.ownerId == request.auth.uid
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 60
        && data.email is string && data.email.size() <= 120
        && data.photoURL is string && data.photoURL.size() <= 400
        && data.onlineName is string && data.onlineName.size() >= 1 && data.onlineName.size() <= 16
        && data.coins is number && data.coins >= 0 && data.coins <= 100000000
        && data.xp is number && data.xp >= 0 && data.xp <= 100000000
        && data.wins is number && data.wins >= 0 && data.wins <= 1000000
        && data.selectedCar is string && data.selectedCar.size() >= 1 && data.selectedCar.size() <= 20
        && data.selectedCar.matches('^[a-zA-Z0-9_\\-]+$')
        && isValidTrackId(data.selectedTrack)
        && data.unlockedCars is list
        && data.unlockedCars.size() >= 1 && data.unlockedCars.size() <= 12
        && data.unlockedCars[0] is string && data.unlockedCars[0].size() <= 20
        && isValidWeather(data.weather)
        && data.volume is number && data.volume >= 0 && data.volume <= 1
        && data.muted is bool
        && isValidTouch(data.touch)
        && data.cameraMode is number && data.cameraMode >= 0 && data.cameraMode <= 2
        && data.laps is number && data.laps in [1, 3, 5]
        && isValidDifficulty(data.difficulty)
        && data.custom is map && data.custom.keys().size() <= 12
        && isValidLeaderboards(data.leaderboards)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUserGhost(data) {
      return data.keys().hasAll([
          'ownerId', 'trackId', 'lapTime', 'coords', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'trackId', 'lapTime', 'coords', 'createdAt', 'updatedAt'
        ])
        && data.ownerId is string
        && isValidId(data.ownerId)
        && data.ownerId == request.auth.uid
        && isValidTrackId(data.trackId)
        && data.lapTime is number && data.lapTime >= 0 && data.lapTime <= 3600
        && data.coords is list && data.coords.size() <= 5400
        && (data.coords.size() == 0 || data.coords[0] is number)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidTrackRecord(data) {
      return data.keys().hasAll([
          'userId', 'driverName', 'trackId', 'carName', 'mode', 'time', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'userId', 'driverName', 'trackId', 'carName', 'mode', 'time', 'createdAt', 'updatedAt'
        ])
        && data.userId is string
        && isValidId(data.userId)
        && data.userId == request.auth.uid
        && data.driverName is string && data.driverName.size() >= 1 && data.driverName.size() <= 24
        && isValidTrackId(data.trackId)
        && data.carName is string && data.carName.size() >= 1 && data.carName.size() <= 40
        && data.mode is string && data.mode.size() >= 1 && data.mode.size() <= 16 && data.mode in ['Race', 'Time Trial', 'Online']
        && data.time is number && data.time > 1 && data.time <= 3600
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // ===== Battle Royale Helpers =====
    function isValidBrMode(m) {
      return m is string && m in ['solo', 'duo', 'squad', 'zerobuild', 'creative'];
    }

    function isValidItemType(t) {
      return t is string && t in ['skin', 'hair', 'backpack', 'pickaxe', 'glider', 'emote'];
    }

    function isValidFriendStatus(s) {
      return s is string && s in ['pending', 'accepted', 'blocked'];
    }

    function isValidPlayer(data) {
      return data.keys().hasAll([
          'ownerId', 'username', 'avatar', 'level', 'xp', 'wins', 'kills', 'coins',
          'matchesPlayed', 'battlePassTier', 'battlePassPremium', 'loadout', 'quests',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'username', 'avatar', 'level', 'xp', 'wins', 'kills', 'coins',
          'matchesPlayed', 'battlePassTier', 'battlePassPremium', 'loadout', 'quests',
          'createdAt', 'updatedAt'
        ])
        && data.ownerId is string
        && isValidId(data.ownerId)
        && data.ownerId == request.auth.uid
        && data.username is string && data.username.size() >= 1 && data.username.size() <= 24
        && data.avatar is string && data.avatar.size() <= 400
        && data.level is number && data.level >= 1 && data.level <= 1000
        && data.xp is number && data.xp >= 0 && data.xp <= 100000000
        && data.wins is number && data.wins >= 0 && data.wins <= 1000000
        && data.kills is number && data.kills >= 0 && data.kills <= 10000000
        && data.coins is number && data.coins >= 0 && data.coins <= 100000000
        && data.matchesPlayed is number && data.matchesPlayed >= 0 && data.matchesPlayed <= 1000000
        && data.battlePassTier is number && data.battlePassTier >= 1 && data.battlePassTier <= 100
        && data.battlePassPremium is bool
        && data.loadout is map && data.loadout.keys().size() <= 8
        && data.quests is map && data.quests.keys().size() <= 10
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidMatch(data) {
      return data.keys().hasAll([
          'match_id', 'mode', 'players', 'winner', 'started_at', 'ended_at',
          'createdBy', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'match_id', 'mode', 'players', 'winner', 'started_at', 'ended_at',
          'createdBy', 'createdAt', 'updatedAt'
        ])
        && data.match_id is string && isValidId(data.match_id) && data.match_id.size() <= 64
        && isValidBrMode(data.mode)
        && data.players is list && data.players.size() >= 1 && data.players.size() <= 100
        && data.players[0] is string && data.players[0].size() <= 48
        && data.winner is string && data.winner.size() >= 1 && data.winner.size() <= 48
        && data.started_at is string && data.started_at.size() >= 1 && data.started_at.size() <= 48
        && data.ended_at is string && data.ended_at.size() >= 1 && data.ended_at.size() <= 48
        && data.createdBy is string && isValidId(data.createdBy) && data.createdBy == request.auth.uid
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidInventoryItem(data) {
      return data.keys().hasAll([
          'player_id', 'item_id', 'item_type', 'equipped', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'player_id', 'item_id', 'item_type', 'equipped', 'createdAt', 'updatedAt'
        ])
        && data.player_id is string && isValidId(data.player_id) && data.player_id == request.auth.uid
        && data.item_id is string && isValidId(data.item_id) && data.item_id.size() <= 48
        && isValidItemType(data.item_type)
        && data.equipped is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidFriendLink(data) {
      return data.keys().hasAll([
          'player_id', 'friend_id', 'friend_name', 'status', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'player_id', 'friend_id', 'friend_name', 'status', 'createdAt', 'updatedAt'
        ])
        && data.player_id is string && isValidId(data.player_id)
        && data.friend_id is string && isValidId(data.friend_id)
        && data.friend_name is string && data.friend_name.size() >= 1 && data.friend_name.size() <= 24
        && isValidFriendStatus(data.status)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // ===== Preserved Racing Collections =====
    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;
      allow create: if isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming())
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName', 'email', 'photoURL', 'onlineName',
          'coins', 'xp', 'wins', 'selectedCar', 'selectedTrack',
          'unlockedCars', 'weather', 'volume', 'muted', 'touch',
          'cameraMode', 'laps', 'difficulty', 'custom', 'leaderboards',
          'updatedAt'
        ]);
      allow delete: if false;

      match /ghosts/{trackId} {
        allow get: if isValidId(userId) && isValidTrackId(trackId) && isOwner(userId);
        allow list: if isOwner(userId) && resource.data.ownerId == request.auth.uid;
        allow create: if isValidId(userId)
          && isValidTrackId(trackId)
          && isOwner(userId)
          && isValidUserGhost(incoming())
          && incoming().trackId == trackId
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId));
        allow update: if isValidId(userId)
          && isValidTrackId(trackId)
          && isOwner(userId)
          && isValidUserGhost(incoming())
          && incoming().ownerId == existing().ownerId
          && incoming().trackId == existing().trackId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'lapTime', 'coords', 'updatedAt'
          ])
          && exists(/databases/$(database)/documents/users/$(userId));
        allow delete: if isValidId(userId)
          && isValidTrackId(trackId)
          && isOwner(userId)
          && existing().ownerId == request.auth.uid;
      }
    }

    match /trackRecords/{recordId} {
      allow get: if isValidId(recordId) && isVerifiedSignedIn();
      allow list: if isVerifiedSignedIn() && resource.data.time > 1;
      allow create: if isValidId(recordId)
        && isVerifiedSignedIn()
        && isValidTrackRecord(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(recordId)
        && isVerifiedSignedIn()
        && existing().userId == request.auth.uid
        && isValidTrackRecord(incoming())
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'driverName', 'trackId', 'carName', 'mode', 'time', 'updatedAt'
        ]);
      allow delete: if isValidId(recordId)
        && isVerifiedSignedIn()
        && existing().userId == request.auth.uid;
    }

    // ===== Battle Royale Collections =====
    match /players/{playerId} {
      allow get: if isValidId(playerId) && isVerifiedSignedIn();
      allow list: if isVerifiedSignedIn() && resource.data.level >= 1;
      allow create: if isValidId(playerId)
        && isOwner(playerId)
        && isValidPlayer(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(playerId)
        && isOwner(playerId)
        && isValidPlayer(incoming())
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'username', 'avatar', 'level', 'xp', 'wins', 'kills', 'coins',
          'matchesPlayed', 'battlePassTier', 'battlePassPremium', 'loadout', 'quests',
          'updatedAt'
        ]);
      allow delete: if false;
    }

    match /matches/{matchId} {
      allow get: if isValidId(matchId) && isVerifiedSignedIn();
      allow list: if isVerifiedSignedIn() && resource.data.players.size() >= 1;
      allow create: if isValidId(matchId)
        && isVerifiedSignedIn()
        && isValidMatch(incoming())
        && incoming().match_id == matchId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if false;
      allow delete: if false;
    }

    match /inventory/{entryId} {
      allow get: if isValidId(entryId) && isVerifiedSignedIn() && resource.data.player_id == request.auth.uid;
      allow list: if isVerifiedSignedIn() && resource.data.player_id == request.auth.uid;
      allow create: if isValidId(entryId)
        && isVerifiedSignedIn()
        && isValidInventoryItem(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(entryId)
        && isVerifiedSignedIn()
        && existing().player_id == request.auth.uid
        && isValidInventoryItem(incoming())
        && incoming().player_id == existing().player_id
        && incoming().item_id == existing().item_id
        && incoming().item_type == existing().item_type
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['equipped', 'updatedAt']);
      allow delete: if isValidId(entryId)
        && isVerifiedSignedIn()
        && existing().player_id == request.auth.uid;
    }

    match /shop_items/{itemId} {
      allow get: if isValidId(itemId) && isVerifiedSignedIn();
      allow list: if isVerifiedSignedIn() && resource.data.price >= 0;
      allow create, update, delete: if false;
    }

    match /friends/{friendshipId} {
      allow get: if isValidId(friendshipId)
        && isVerifiedSignedIn()
        && (resource.data.player_id == request.auth.uid || resource.data.friend_id == request.auth.uid);
      allow list: if isVerifiedSignedIn()
        && (resource.data.player_id == request.auth.uid || resource.data.friend_id == request.auth.uid);
      allow create: if isValidId(friendshipId)
        && isVerifiedSignedIn()
        && isValidFriendLink(incoming())
        && incoming().player_id == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(friendshipId)
        && isVerifiedSignedIn()
        && (existing().player_id == request.auth.uid || existing().friend_id == request.auth.uid)
        && isValidFriendLink(incoming())
        && incoming().player_id == existing().player_id
        && incoming().friend_id == existing().friend_id
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'friend_name', 'updatedAt']);
      allow delete: if isValidId(friendshipId)
        && isVerifiedSignedIn()
        && (existing().player_id == request.auth.uid || existing().friend_id == request.auth.uid);
    }
  }
}
